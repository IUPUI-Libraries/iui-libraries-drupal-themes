{% set title = "" %}
{% set subtitle = "" %}
{% if iui_libraries_alt_slogan %}
  {% set title = slogan %}
  {% set subtitle ="Indiana University " ~ iui_libraries_campus %}
{% else %}
  {% set title = "Indiana University " ~ iui_libraries_campus %}
  {% set subtitle = slogan %}
{% endif %}
<header class="rvt-header-wrapper" style="z-index: 300;">
  <!-- Hidden link for keyboard users to skip to main content -->
  <a class="rvt-header-wrapper__skip-link" href="#main-content">Skip to main content</a>
  <div class="rvt-header-global rvt-border-bottom">
    <div class="rvt-container-xl">
      <div class="rvt-header-global__inner">
        <div class="rvt-header-global__logo-slot">
          <a class="rvt-lockup" href="{% if iui_libraries_top_url is not empty %}{{ iui_libraries_top_url }}{% else %}https://indianapolis.iu.edu/{% endif %}">
            <!-- Trident logo -->
            <div class="rvt-lockup__tab">
              <svg xmlns="http://www.w3.org/2000/svg" class="rvt-lockup__trident" viewBox="0 0 28 34">
                <path d="M-3.34344e-05 4.70897H8.83308V7.174H7.1897V21.1426H10.6134V2.72321H8.83308V0.121224H18.214V2.65476H16.2283V21.1426H19.7889V7.174H18.214V4.64047H27.0471V7.174H25.0614V23.6761L21.7746 26.8944H16.2967V30.455H18.214V33.8787H8.76463V30.592H10.6819V26.8259H5.20403L1.91726 23.6077V7.174H-3.34344e-05V4.70897Z" fill="currentColor"></path>
              </svg>
            </div>
            <!-- Website or application title -->
            <div class="rvt-lockup__body">
              {# {% if iui_libraries_campus != 'none' %}
              <span class="rvt-lockup__title">Indiana University  {{ iui_libraries_campus }}</span>
              <span class="rvt-lockup__subtitle">{{ slogan }}</span>
              {% else %}
              <span class="rvt-lockup__title">Indiana University</span>
              <span class="rvt-lockup__subtitle">{{ slogan }}</span>
              {% endif %} #}
              <span class="rvt-lockup__title">{{ title }}</span>
              <span class="rvt-lockup__subtitle">{{ subtitle }}</span>
            </div>
          </a>
        </div>
        <!-- Header controls -->
        {{ page.primary_menu}}
      </div>
    </div>
  </div>
  <div class="rvt-header-local">
    <div class="rvt-container rvt-container--center rvt-container-xl">
      <div class="rvt-header-local__inner" data-rvt-disclosure="local-header-menu" data-rvt-close-click-outside style="align-items: flex-start !important; flex-direction: column;">
        <a href="{{ path('<front>') }}" class="rvt-ts-sm rvt-color-black rvt-text-bold" style="text-decoration: none;">
          {{ site_name }}
        </a>
        {{ page.secondary_menu }}
      </div>
    </div>
  </div>
</header>
