{#
/**
 * @file
 * Theme override for an 'input' #type submit form element.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 *
 * @see template_preprocess_input()
 */
#}

{# Add rivet classes to input elements #}
{% set attributes = attributes.addClass('rvt-button rvt-m-top-md') %}
<input{{ attributes }} />{{ children }}